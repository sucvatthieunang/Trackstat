local Runtime = {
    Alive = true,
    Threads = {},
    Jobs = {},
    Checks = {}
}
function Runtime:Stop()
    self.Alive = false
    for _, Thread in self.Threads do
        pcall(task.cancel, Thread)
    end
    for _, Thread in self.Jobs do
        pcall(task.cancel, Thread)
    end
end
getgenv().TrackstatRuntime = Runtime

local Sent = {}
local PrimaryURL = "http://103.216.126.28:2029/abqU2IemNb"
local EventURL = "http://103.216.126.28:0901/1DxKuaiMHG"
local function Send(URL, Payload, Cooldown)
    local Value = Payload.Haki or Payload["Rare Boss"] or Payload["Prehistoric Island"] or
        Payload.Mirage or Payload.MoonPhase or Payload.Elite or Payload.Berry or Payload.Fruit
    local Key = Payload.Type .. ":" .. tostring(Value)

    if Sent[Key] and os.clock() - Sent[Key] < (Cooldown or 60) then
        return false
    end

    local Response = HttpRequest({
        Url = URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(Payload),
        Timeout = 10
    })

    local Status = type(Response) == "table" and tonumber(Response.StatusCode)
    assert(Status and Status >= 200 and Status < 300, "Trackstat: HTTP " .. tostring(Status))

    Sent[Key] = os.clock()
    return true
end

local function Poll(Name, Check)
    Runtime.Threads[#Runtime.Threads + 1] = task.spawn(function()
        while Runtime.Alive do
            local Done = false
            Runtime.Jobs[Name] = task.spawn(function()
                local OK, Error = xpcall(Check, debug.traceback)
                Runtime.Checks[Name] = {
                    OK = OK,
                    Error = not OK and tostring(Error) or nil,
                    At = os.clock()
                }
                if not OK then
                    warn("[Trackstat] " .. Name .. ": " .. tostring(Error))
                end
                Done = true
            end)
            local Deadline = os.clock() + 15
            repeat
                task.wait(0.5)
            until Done or not Runtime.Alive or os.clock() >= Deadline
            if not Done then
                pcall(task.cancel, Runtime.Jobs[Name])
                Runtime.Checks[Name] = {
                    OK = false,
                    Error = "timeout",
                    At = os.clock()
                }
                warn("[Trackstat] " .. Name .. ": timeout")
            end
            Runtime.Jobs[Name] = nil
            task.wait(5)
        end
    end)
end

