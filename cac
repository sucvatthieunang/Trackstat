local Runtime = {
    Alive = true,
    Threads = {},
    Jobs = {},
    Checks = {},
    Connections = {}
}
function Runtime:Stop()
    self.Alive = false
    for _, Thread in self.Threads do
        pcall(task.cancel, Thread)
    end
    for _, Job in self.Jobs do
        pcall(task.cancel, Job.Thread)
    end
    for _, Connection in self.Connections do
        Connection:Disconnect()
    end
end
getgenv().TrackstatRuntime = Runtime

local Sent = {}
local PrimaryURL = "http://103.216.126.28:2029/abqU2IemNb"
local EventURL = "http://103.216.126.28:0901/1DxKuaiMHG"
local function Send(URL, Payload, Cooldown)
    local Value = Payload.Haki or Payload["Rare Boss"] or Payload["Prehistoric Island"] or
        Payload.Mirage or Payload.MoonPhase or Payload.Elite or Payload.Berry or Payload.Fruit
    local Key = Payload.Type .. ":" .. tostring(Value)

    if Sent[Key] and os.clock() - Sent[Key] < (Cooldown or 60) then
        return false
    end

    PostJSON(URL, Payload)
    Sent[Key] = os.clock()
    return true
end

function PostJSON(URL, Payload)
    local Response = HttpRequest({
        Url = URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(Payload),
        Timeout = 10
    })

    local Status = type(Response) == "table" and tonumber(Response.StatusCode)
    assert(Status and Status >= 200 and Status < 300, "Trackstat: HTTP " .. tostring(Status))
end

-- Một luồng lập lịch duy nhất chạy mọi check mỗi TICK giây.
-- TICK + cooldown 60s của Send vẫn nhỏ hơn TTL 90s phía server.
local TICK = 15
local TIMEOUT = 15
local Checks = {}
local function Poll(Name, Check)
    Checks[#Checks + 1] = {Name = Name, Check = Check}
end

local function RunChecks()
    local Now = os.clock()
    for _, Item in Checks do
        local Name, Job = Item.Name, Runtime.Jobs[Item.Name]
        if Job then
            -- Check lần trước vẫn chưa xong (vd. InvokeServer bị treo)
            if Now - Job.Start >= TIMEOUT then
                pcall(task.cancel, Job.Thread)
                Runtime.Jobs[Name] = nil
                Runtime.Checks[Name] = {OK = false, Error = "timeout", At = Now}
                warn("[Trackstat] " .. Name .. ": timeout")
            end
            continue
        end
        local Entry = {Start = Now}
        Runtime.Jobs[Name] = Entry
        Entry.Thread = task.spawn(function()
            local OK, Error = xpcall(Item.Check, debug.traceback)
            if Runtime.Jobs[Name] == Entry then
                Runtime.Jobs[Name] = nil
            end
            Runtime.Checks[Name] = {OK = OK, Error = not OK and tostring(Error) or nil, At = os.clock()}
            if not OK then
                warn("[Trackstat] " .. Name .. ": " .. tostring(Error))
            end
        end)
    end
end

