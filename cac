-- ===================== Boss realtime =====================
-- Rare Boss (EventURL) và Elite (PrimaryURL) được theo dõi bằng sự kiện:
--  * boss xuất hiện  -> gửi ngay Alive = true
--  * boss chết/biến mất -> gửi ngay Alive = false để server xóa entry
--  * còn sống -> heartbeat mỗi BOSS_HEARTBEAT giây (kèm % máu), server giữ entry tối đa 30s
local BOSS_HEARTBEAT = 10
local DEATH_GRACE = 1 -- boss chuyển giữa Enemies <-> ReplicatedStorage có thể mất parent một nhịp
local Enemies -- workspace.Enemies, gán khi tìm thấy

local function MatchBoss(ModelName)
    for Name in BossKinds do
        if ModelName:find(Name, 1, true) then return Name end
    end
end

local function BossPayload(Name, State, Alive)
    return {
        ["JobId"] = tostring(game.JobId),
        ["Players"] = Players.NumPlayers .. "/" .. Players.MaxPlayers,
        ["ClockTime"] = math.floor(game.Lighting.ClockTime),
        [State.Kind] = Name,
        ["Alive"] = Alive,
        ["Health"] = State.Health,
        ["IsNight"] = isnight(),
        ["PlaceID"] = game.PlaceId,
        ["cac"] = Players.LocalPlayer.Name,
        ["Type"] = State.Kind
    }
end

-- Gửi trạng thái boss theo thứ tự (không bao giờ có 2 request cùng boss chạy song song,
-- nên "chết" không thể đến server trước "sống").
local function SyncBoss(Name)
    local State = BossState[Name]
    if State.Busy then return end
    State.Busy = true
    task.spawn(function()
        while Runtime.Alive do
            if not State.Want and State.Reported then
                task.wait(DEATH_GRACE)
                if State.Want then continue end
            end
            local Want = State.Want
            local Due = Want ~= State.Reported or (Want and os.clock() - State.LastSent >= BOSS_HEARTBEAT)
            if not Due then break end
            local URL = State.Kind == "Elite" and PrimaryURL or EventURL
            local OK, Error = pcall(PostJSON, URL, BossPayload(Name, State, Want))
            if not OK then
                warn("[Trackstat] " .. Name .. ": " .. tostring(Error))
                break -- thử lại ở heartbeat kế tiếp
            end
            if Want and not State.Reported and State.Kind == "Rare Boss" then
                task.spawn(pcall, anat, "Boss", Name)
            end
            State.Reported, State.LastSent = Want, os.clock()
        end
        State.Busy = false
    end)
end

local function UpdateBoss(Name)
    local State = BossState[Name]
    local Alive, Health = false, 0
    for Model, Connections in State.Models do
        local Parent = Model.Parent
        if Parent == nil then
            for _, Connection in Connections do Connection:Disconnect() end
            State.Models[Model] = nil
        elseif Parent == Enemies or Parent == ReplicatedStorage then
            local Humanoid = Model:FindFirstChildOfClass("Humanoid")
            if Humanoid and Humanoid.Health > 0 then
                Alive = true
                Health = math.max(Health, math.floor(Humanoid.Health / math.max(Humanoid.MaxHealth, 1) * 100))
            end
        end
    end
    State.Want, State.Health = Alive, Health
    SyncBoss(Name)
end

local function WatchBoss(Model)
    if not Model:IsA("Model") then return end
    local Name = MatchBoss(Model.Name)
    if not Name then return end
    local State = BossState[Name]
    if State.Models[Model] then return UpdateBoss(Name) end

    local Connections = {}
    State.Models[Model] = Connections
    local function Update() UpdateBoss(Name) end
    local function HookHumanoid(Humanoid)
        Connections[#Connections + 1] = Humanoid.Died:Connect(Update)
        Connections[#Connections + 1] = Humanoid.HealthChanged:Connect(function(Health)
            if Health <= 0 then Update() end
        end)
    end
    Connections[#Connections + 1] = Model.AncestryChanged:Connect(Update)
    local Humanoid = Model:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        HookHumanoid(Humanoid)
    else
        Connections[#Connections + 1] = Model.ChildAdded:Connect(function(Child)
            if Child:IsA("Humanoid") then
                HookHumanoid(Child)
                Update()
            end
        end)
    end
    Update()
end

local function WatchFolder(Folder)
    Runtime.Connections[#Runtime.Connections + 1] = Folder.ChildAdded:Connect(WatchBoss)
    for _, Child in Folder:GetChildren() do
        WatchBoss(Child)
    end
end

