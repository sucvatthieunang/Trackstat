function HaveRareBoss(name)
    for _, Folder in {workspace:FindFirstChild("Enemies"), ReplicatedStorage} do
        if not Folder then continue end
        for _, Boss in Folder:GetChildren() do
            local Humanoid = Boss:IsA("Model") and Boss:FindFirstChildOfClass("Humanoid")
            if Boss.Name:find(name, 1, true) and Humanoid and Humanoid.Health > 0 then return true end
        end
    end
    return false
end

